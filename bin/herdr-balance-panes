#!/usr/bin/env python3
"""Balance the active Herdr tab without replacing its live panes."""

import json
import os
import socket
import sys
import uuid


def fail(message):
    print(f"herdr-balance-panes: {message}", file=sys.stderr)
    raise SystemExit(1)


socket_path = os.environ.get("HERDR_SOCKET_PATH")
if not socket_path:
    fail("HERDR_SOCKET_PATH is not set; run this from a Herdr custom command")


def request(method, params):
    request_id = f"balance-panes:{uuid.uuid4()}"
    payload = json.dumps(
        {"id": request_id, "method": method, "params": params},
        separators=(",", ":"),
    ).encode() + b"\n"

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(socket_path)
        client.sendall(payload)
        response = b""
        while not response.endswith(b"\n"):
            chunk = client.recv(65536)
            if not chunk:
                break
            response += chunk

    if not response:
        fail(f"no response to {method}")
    decoded = json.loads(response)
    if "error" in decoded:
        error = decoded["error"]
        fail(f"{method}: {error.get('code', 'error')}: {error.get('message', '')}")
    return decoded["result"]


target = {}
if os.environ.get("HERDR_ACTIVE_TAB_ID"):
    target["tab_id"] = os.environ["HERDR_ACTIVE_TAB_ID"]
elif os.environ.get("HERDR_ACTIVE_PANE_ID"):
    target["pane_id"] = os.environ["HERDR_ACTIVE_PANE_ID"]

layout = request("layout.export", target)["layout"]
updates = []


def collect_updates(node, path):
    if node["type"] == "pane":
        return 1

    first_count = collect_updates(node["first"], path + [False])
    second_count = collect_updates(node["second"], path + [True])
    total = first_count + second_count
    updates.append((path, first_count / total))
    return total


collect_updates(layout["root"], [])
for path, ratio in updates:
    request(
        "layout.set_split_ratio",
        {"tab_id": layout["tab_id"], "path": path, "ratio": ratio},
    )
